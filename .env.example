# Server
PORT=3000

# Postgres connection string (added in phase 2 — local dev via docker-compose)
DATABASE_URL=postgres://pinghub:pinghub@localhost:5432/pinghub

# Redis connection string, used by the BullMQ job queue (added in phase 3 — local dev via docker-compose)
REDIS_URL=redis://localhost:6379

# --- Channel provider credentials (added in phases 4-6) ---

# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=

# Firebase Cloud Messaging (push) — service account JSON from the Firebase console,
# either as a file path or the raw JSON contents
FIREBASE_SERVICE_ACCOUNT=

# Twilio (SMS) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
