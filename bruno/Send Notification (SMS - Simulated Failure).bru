meta {
  name: Send Notification (SMS - Simulated Failure)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "user-123",
    "channel": "sms",
    "destination": "+15555550100",
    "message": "This one is forced to fail",
    "simulateFailure": true
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("failedNotificationId", res.body.id);
  }
}

docs {
  Delivery is async: the response here is always `202 queued`, even though
  `simulateFailure: true` will make every delivery attempt fail. Run "Get
  Notification Status (Failed)" a moment later, once the worker has
  exhausted its retries, to see the final `failed` status and error.
}

assert {
  res.status: eq 202
  res.body.status: eq queued
}
