meta {
  name: Send Notification (SMS - Simulated Failure)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "user-123",
    "channel": "sms",
    "destination": "+15555550100",
    "message": "This one is forced to fail",
    "simulateFailure": true
  }
}

assert {
  res.status: eq 201
  res.body.status: eq failed
}
