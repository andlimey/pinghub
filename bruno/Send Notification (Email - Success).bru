meta {
  name: Send Notification (Email - Success)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/notifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "user-123",
    "channel": "email",
    "destination": "andy@example.com",
    "message": "Hello from PingHub!"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("notificationId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq delivered
}
