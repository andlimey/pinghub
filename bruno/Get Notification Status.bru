meta {
  name: Get Notification Status
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/notifications/{{notificationId}}
  body: none
  auth: none
}

docs {
  Run "Send Notification (Email - Success)" first — it captures the
  returned id into the {{notificationId}} collection variable that
  this request reads.

  Delivery is async, so status may still read `queued` or `processing`
  immediately after sending — re-run this request a moment later if you
  want to see it settle on `delivered`.
}

assert {
  res.status: eq 200
}
